generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. UTILIZADORES ADMINISTRATIVOS & RBAC
// -------------------------------------------------------------
model AdminUser {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  password           String?
  passwordHash       String?
  role               String      @default("editor") // 'admin' | 'editor' | 'ADMINISTRADOR' | 'TECNICO_RH' | 'FUNCIONARIO'
  avatar             String?
  status             String      @default("active") // 'active' | 'inactive'
  mustChangePassword Boolean     @default(false)
  createdAt          DateTime    @default(now())
  lastLogin          DateTime?
  hrEmployee         HrEmployee?
}


// -------------------------------------------------------------
// 2. CLIENTES & CONTAS DE CLIENTE
// -------------------------------------------------------------
model Customer {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  password     String?
  passwordHash String?
  phone        String
  company      String?
  nif          String?
  address      String?
  city         String?            @default("Luanda")
  avatar       String?
  status       String             @default("active") // 'active' | 'inactive'
  notes        String?
  createdAt    DateTime           @default(now())
  lastLogin    DateTime?
  orders       StoreOrder[]
  reservations ProductReservation[]
  tickets      Ticket[]
}

// -------------------------------------------------------------
// 3. CATEGORIAS & PRODUTOS DA LOJA
// -------------------------------------------------------------
model ProductCategory {
  id            String    @id @default(cuid())
  name          String    @unique
  icon          String    @default("Package")
  description   String?
  order         Int       @default(0)
  hideWhenEmpty Boolean   @default(false)
  products      Product[]
}

model Product {
  id           String             @id @default(cuid())
  name         String
  slug         String?            @unique  // URL-friendly identifier (gerado a partir do nome)
  description  String
  categoryId   String?
  categoryRef  ProductCategory?   @relation(fields: [categoryId], references: [id])
  category     String             // Nome da categoria desnormalizado para consultas rápidas
  brand        String?            // Marca do produto (HP, Epson, TP-Link, etc.)
  price        Float?             // Preço base; null = Sob consulta
  image        String
  images       String?            // JSON array serializado de strings
  inStock      Boolean            @default(true)
  quantity     Int                @default(0)
  featured     Boolean            @default(false)
  sku          String?
  baseSpecs    String?            // JSON de especificações técnicas gerais do produto pai
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  variants     ProductVariant[]
  orderItems   StoreOrderItem[]
  reservations ProductReservation[]
}

// Atributos flexíveis por tipo de produto (Cor, RAM, Armazenamento, Conectividade...)
model ProductOption {
  id     String               @id @default(cuid())
  name   String               @unique  // "Cor", "RAM", "Armazenamento", "Conectividade"
  order  Int                  @default(0)
  values ProductOptionValue[]
}

// Valores de cada atributo ("Azul", "16GB", "512GB SSD", "Wi-Fi")
model ProductOptionValue {
  id       String                  @id @default(cuid())
  optionId String
  optionRef ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value    String                  // Texto visível ao utilizador
  hex      String?                 // Código hex da cor (ex: "#1E40AF"); null para atributos não-cor
  order    Int                     @default(0)
  variants ProductVariantOption[]

  @@unique([optionId, value])
}

// Variante concreta de um produto (combinação específica de opções)
model ProductVariant {
  id        String                  @id @default(cuid())
  productId String
  productRef Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String                  @unique
  price     Float?                  // null = usa preço base do produto pai
  stock     Int                     @default(0)
  images    String?                 // JSON array de URLs de imagens desta variante
  specs     String?                 // JSON de especificações técnicas específicas desta variante
  active    Boolean                 @default(true)
  order     Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  options   ProductVariantOption[]
  orderItems StoreOrderItem[]
}

// Tabela pivot: liga uma variante aos seus valores de opção
model ProductVariantOption {
  id             String             @id @default(cuid())
  variantId      String
  variantRef     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValueId  String
  optionValueRef ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
}

// -------------------------------------------------------------
// 4. ENCOMENDAS & ITENS
// -------------------------------------------------------------
model StoreOrder {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  customerId          String?
  customerRef         Customer?        @relation(fields: [customerId], references: [id])
  customerName        String
  customerEmail       String
  customerPhone       String
  customerCompany     String?
  customerNif         String?
  customerCity        String?
  customerAddress     String?
  deliveryMethod      String?          @default("entrega_luanda")
  paymentMethod       String?          @default("transferencia")
  total               Float?
  status              String           @default("novo") // 'novo' | 'em_contacto' | 'fechado' | 'cancelado'
  notes               String?
  whatsappPhone       String?
  botStatus           String?          @default("bot_active")
  receiptUrl          String?
  receiptFilename     String?
  receiptReceivedAt   DateTime?
  conversationHistory String?          // JSON array serializado de mensagens WhatsApp
  confirmedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  items               StoreOrderItem[]
}

model StoreOrderItem {
  id           String          @id @default(cuid())
  orderId      String
  orderRef     StoreOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  productRef   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variantRef   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantSku   String?         // SKU da variante no momento da compra
  variantLabel String?         // Rótulo legível (ex: "16GB RAM / 512GB SSD / Prata")
  price        Float?
  quantity     Int             @default(1)
  image        String?
}

// -------------------------------------------------------------
// 5. RESERVAS DE EQUIPAMENTOS
// -------------------------------------------------------------
model ProductReservation {
  id                String    @id @default(cuid())
  reservationNumber String    @unique
  productId         String?
  productRef        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId        String?
  customerRef       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productName       String
  productImage      String?
  productPrice      Float?
  customerName      String
  customerEmail     String
  customerPhone     String
  customerCompany   String?
  quantity          Int       @default(1)
  notes             String?
  status            String    @default("pendente") // 'pendente' | 'em_contacto' | 'confirmada' | 'notificado' | 'cancelada'
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// -------------------------------------------------------------
// 6. LEADS COMERCIAIS & NEWSLETTER
// -------------------------------------------------------------
model ServiceLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String
  status    String   @default("novo") // 'novo' | 'contactado' | 'convertido' | 'arquivado'
  notes     String?
  source    String?  @default("site_quote")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  status       String   @default("active") // 'active' | 'inactive'
  subscribedAt DateTime @default(now())
}

model NewsletterCampaign {
  id               String   @id @default(cuid())
  subject          String
  body             String   // Conteúdo HTML da newsletter
  coverImage       String?  // Imagem de capa (banner no topo do email)
  coverImageAlt    String?  // Texto alternativo da imagem de capa
  offerBannerImage String?  // Imagem do banner de oferta (opcional)
  offerBannerAlt   String?  // Texto alternativo do banner de oferta
  offerBannerLink  String?  // Link de destino do banner de oferta
  featuredProducts String?  // JSON serializado dos 3 produtos mais pedidos
  recipientCount   Int      @default(0)
  successCount     Int      @default(0)
  failCount        Int      @default(0)
  status           String   @default("rascunho") // 'rascunho' | 'a_enviar' | 'enviada' | 'erro'
  sentBy           String?  // Nome do admin que enviou
  sentAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


// -------------------------------------------------------------
// 7. EVENTOS & INSCRIÇÕES
// -------------------------------------------------------------
model Event {
  id               String              @id @default(cuid())
  title            String
  slug             String              @unique
  date             String
  time             String?
  location         String
  format           String              @default("Presencial") // 'Presencial' | 'Online' | 'Híbrido'
  description      String
  fullDescription  String?
  image            String?
  capacity         Int?
  status           String              @default("agendado") // 'agendado' | 'a_decorrer' | 'encerrado' | 'cancelado'
  speakers         String?             // JSON serializado
  schedule         String?             // JSON serializado
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  registrations    EventRegistration[]
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  eventRef     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  company      String?
  position     String?
  status       String   @default("pendente") // 'pendente' | 'confirmada' | 'cancelada'
  ticketCode   String?
  registeredAt DateTime @default(now())
}

// -------------------------------------------------------------
// 8. FORMAÇÃO / ACADEMIA ARKNET
// -------------------------------------------------------------
model Course {
  id          String   @id @default(cuid())
  title       String
  category    String
  duration    String
  level       String
  format      String
  description String
  price       Float?
  icon        String?
  skills      String?  // JSON array serializado de tópicos
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// 9. PROJETOS & ATIVIDADES DIÁRIAS (BLOG/NOTÍCIAS)
// -------------------------------------------------------------
model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  client          String
  category        String
  sector          String?
  year            Int?
  description     String
  fullDescription String?
  metrics         String?  // JSON serializado
  challenge       String?
  solution        String?
  results         String?  // JSON array serializado
  testimonial     String?  // JSON serializado
  image           String?
  gallery         String?  // JSON array serializado
  featured        Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
}

model DailyActivity {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  date      String
  category  String
  summary   String
  content   String
  author    String?
  image     String?
  readTime  String?
  tags      String?  // JSON array serializado
  featured  Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
}

// -------------------------------------------------------------
// 10. PARCEIROS & TESTEMUNHOS
// -------------------------------------------------------------
model Partner {
  id       String  @id @default(cuid())
  name     String
  logo     String
  website  String?
  category String?
  order    Int     @default(0)
  active   Boolean @default(true)
}

model Testimonial {
  id       String  @id @default(cuid())
  name     String
  role     String
  company  String
  avatar   String?
  text     String
  rating   Int     @default(5)
  active   Boolean @default(true)
  order    Int     @default(0)
}

// -------------------------------------------------------------
// 11. CARREIRAS / VAGAS DE EMPREGO
// -------------------------------------------------------------
model Job {
  id               String           @id @default(cuid())
  title            String
  department       String
  location         String
  type             String
  description      String
  requirements     String?          // JSON array serializado
  responsibilities String?          // JSON array serializado
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  applications     JobApplication[]
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String?
  jobRef    Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobTitle  String?
  name      String
  email     String
  phone     String
  resumeUrl String?
  message   String?
  status    String   @default("recebida")
  appliedAt DateTime @default(now())
}

// -------------------------------------------------------------
// 12. CONFIGURAÇÕES INSTITUCIONAIS GLOBAIS
// -------------------------------------------------------------
model CompanySetting {
  id                 String   @id @default("global")
  companyName        String   @default("ARKNET")
  tagline            String?
  phones             String?  // JSON array serializado
  emails             String?  // JSON array serializado
  address            String?
  city               String?  @default("Luanda")
  country            String?  @default("Angola")
  whatsappChannelUrl String?
  whatsappNumber     String?
  socialLinks        String?  // JSON serializado
  institutionalText  String?
  presentationLetter String?
  executiveTeam      String?  // JSON array serializado
  carouselSlides     String?  // JSON array serializado
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------
// 13. LOG DE AUDITORIA & ATIVIDADES ADMINISTRATIVAS
// -------------------------------------------------------------
model AuditActivity {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  target    String
  targetId  String?
  timestamp DateTime @default(now())
  details   String?
}

// -------------------------------------------------------------
// 14. RECLAMAÇÕES & PEDIDOS DE INFORMAÇÃO (TICKETS)
// -------------------------------------------------------------
model Ticket {
  id              String        @id @default(cuid())
  protocol        String        @unique // ex.: "ARK-2026-000123"
  type            String        // "RECLAMACAO" | "INFORMACAO"
  category        String        // "PRODUTO" | "ENTREGA" | "PAGAMENTO" | "ATENDIMENTO" | "SERVICO_TECNICO" | "OUTRO"
  name            String
  email           String
  phone           String?
  subject         String
  message         String        // Text
  orderNumber     String?
  customerId      String?
  customerRef     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String        @default("NOVO") // "NOVO" | "EM_ANALISE" | "RESPONDIDO" | "RESOLVIDO" | "ARQUIVADO"
  priority        String        @default("NORMAL") // "BAIXA" | "NORMAL" | "ALTA"
  consentAccepted Boolean       @default(true)
  consentAt       DateTime      @default(now())
  ipHash          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  resolvedAt      DateTime?
  notes           TicketNote[]
  replies         TicketReply[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([protocol])
}

model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String
  ticketRef Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId   String
  adminName String?
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticketRef Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminId   String
  adminName String?
  content   String
  sentAt    DateTime @default(now())
  channel   String   // "EMAIL" | "WHATSAPP"

  @@index([ticketId])
}

// =============================================================
// 15. RECURSOS HUMANOS (RH) - FASE 1: FUNDAÇÃO
// =============================================================

model HrDepartment {
  id          String         @id @default(cuid())
  code        String         @unique // ex.: "ENG", "RH", "COM"
  name        String
  description String?
  managerId   String?        // ID do funcionário responsável (informativo)
  parentId    String?        // Departamento superior na hierarquia
  parent      HrDepartment?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    HrDepartment[] @relation("DepartmentHierarchy")
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  employees   HrEmployee[]
  jobOpenings HrJobOpening[]

  @@index([parentId])
}

model HrPosition {
  id             String       @id @default(cuid())
  code           String       @unique // ex.: "TEC_TELCO", "ESP_RH"
  title          String
  level          String       // "Junior" | "Pleno" | "Senior" | "Especialista" | "Direccao"
  salaryCategory String       // "CAT-A", "CAT-B", "CAT-C", etc.
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employees      HrEmployee[]
  jobOpenings    HrJobOpening[]
}

model HrEmployee {
  id                 String            @id @default(cuid())
  employeeNumber     String            @unique // ex.: "ARK-EMP-001"
  fullName           String
  biNumber           String            @unique // Bilhete de Identidade único
  birthDate          DateTime
  gender             String?           // "M" | "F" | "Outro"
  phone              String
  email              String            @unique
  address            String
  city               String            @default("Luanda")
  province           String            @default("Luanda")
  
  // Dados bancários (sensíveis)
  bankName           String?
  bankIban           String?
  bankAccountNumber  String?

  admissionDate      DateTime
  status             String            @default("ACTIVO") // "ACTIVO" | "SUSPENSO" | "DESLIGADO"
  
  departmentId       String
  department         HrDepartment      @relation(fields: [departmentId], references: [id])
  
  positionId         String
  position           HrPosition        @relation(fields: [positionId], references: [id])
  
  // Hierarquia - Chefe directo (informativo, não dá permissões)
  directSupervisorId String?
  directSupervisor   HrEmployee?       @relation("SupervisorHierarchy", fields: [directSupervisorId], references: [id], onDelete: SetNull)
  subordinates       HrEmployee[]      @relation("SupervisorHierarchy")

  // Ligação opcional ao utilizador do sistema (para acesso ao portal)
  userId             String?           @unique
  userRef            AdminUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Consentimento de GPS para picagem de ponto (Fase 2)
  locationConsentDate DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  contracts          HrContract[]
  documents          HrDocument[]
  careerHistory      HrCareerHistory[]
  timeEntries        HrTimeEntry[]
  workDays           HrWorkDay[]
  timeCorrections    HrTimeCorrectionRequest[]
  leaveBalances      HrLeaveBalance[]
  leaveRequests      HrLeaveRequest[]
  workLocations      HrEmployeeWorkLocation[]
  timesheets         HrTimesheet[]
  payslips           HrPayslip[]
  performanceReviews HrPerformanceReview[]
  certifications     HrCertification[]

  @@index([departmentId])
  @@index([positionId])
  @@index([status])
}

model HrCareerHistory {
  id           String     @id @default(cuid())
  employeeId   String
  employee     HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position     String
  department   String
  salary       Decimal
  changeReason String     // "Admissão", "Promoção", "Transferência", "Ajuste Salarial"
  changeDate   DateTime   @default(now())
  registeredBy String?
  createdAt    DateTime   @default(now())

  @@index([employeeId])
}

model HrContract {
  id             String     @id @default(cuid())
  contractNumber String     @unique // ex.: "ARK-CTR-2026-001"
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           String     // "INDETERMINADO" | "DETERMINADO" | "ESTAGIO" | "PRESTACAO_SERVICOS"
  startDate      DateTime
  endDate        DateTime?  // Obrigatório se Determinado ou Estágio
  baseSalary     Decimal    // Salário base em Decimal
  
  // Horário de trabalho (preparado para o ponto na Fase 2)
  workDays       String     @default("SEG-SEX") // ex.: "SEG-SEX", "SEG-SAB"
  dailyHours     Decimal    @default(8.0)       // Horas por dia (ex.: 8)
  weeklyHours    Decimal    @default(40.0)      // Horas semanais (ex.: 40)
  
  status         String     @default("RASCUNHO") // "RASCUNHO" | "PENDENTE_APROVACAO" | "ACTIVO" | "VENCIDO" | "RESCINDIDO"
  
  approvedBy     String?    // ID ou nome do Técnico de RH/Admin que aprovou
  approvedAt     DateTime?
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
}

model HrDocument {
  id             String     @id @default(cuid())
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  type           String     // "BI" | "CONTRATO" | "CERTIFICADO" | "CV" | "REGISTO_CRIMINAL" | "ATESTADO_MEDICO" | "OUTRO"
  storagePath    String     // Identificador seguro no armazenamento privado
  fileName       String
  fileSize       Int
  mimeType       String
  expiresAt      DateTime?  // Validade (para alertas de expiração)
  status         String     @default("ACTIVO") // "ACTIVO" | "ARQUIVADO"
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([status])
}

model HrAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  userRole   String
  action     String   // "CRIAR" | "EDITAR" | "APROVAR" | "MUDAR_ESTADO" | "ACESSO_SENSIVEL"
  resource   String   // "FUNCIONARIO" | "CONTRATO" | "DOCUMENTO" | "DEPARTAMENTO" | "CARGO" | "UTILIZADOR"
  resourceId String?
  details    String   // Descrição legível em português de Angola
  oldValue   String?  // JSON string com dados sensíveis mascarados
  newValue   String?  // JSON string com dados sensíveis mascarados
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([createdAt])
}

model HrAlertLog {
  id         String   @id @default(cuid())
  alertType  String   // "CONTRATO_EXPIRACAO" | "DOCUMENTO_EXPIRACAO"
  targetId   String   // ID do Contrato ou Documento
  channel    String   // "EMAIL" | "WHATSAPP"
  sentTo     String   // Destinatário
  sentAt     DateTime @default(now())
  metadata   String?  // JSON com detalhes do alerta

  @@index([alertType, targetId])
  @@index([sentAt])
}

model HrConfig {
  id                            String   @id @default("global")
  contractAlertDays             Int      @default(30)
  documentAlertDays             Int      @default(30)
  notifyEmail                   String   @default("rh@arknet.co.ao")
  notifyWhatsapp                String?
  whatsappEnabled               Boolean  @default(false) // Desligado por configuração (apenas template aprovado)
  
  // Configurações de Ponto e Tolerâncias (Fase 2)
  punctualityToleranceMinutes   Int      @default(10)     // Tolerância em minutos à entrada (default: 10)
  roundingMinutes               Int      @default(0)      // Arredondamento: 0, 5, 10, 15
  dailyOvertimeLimitMinutes     Int?                      // Limite legal diário de horas extra (vazio por defeito)
  monthlyOvertimeLimitMinutes   Int?                      // Limite legal mensal de horas extra (vazio por defeito)
  checkInReminderMinutes        Int      @default(15)     // Minutos após início para lembrete
  gpsRetentionMonths            Int      @default(12)     // Meses de retenção de coordenadas GPS (default: 12)
  annualLeaveDaysDefault        Int      @default(22)     // Direito anual de férias (dias úteis, default: 22)

  // Configurações de Folhas de Ponto e Fecho Mensal (Fase 3A)
  timesheetSubmissionDeadlineDay     Int      @default(5)     // Dia limite no mês seguinte para o funcionário submeter (default: dia 5)
  timesheetClosingDeadlineDay        Int      @default(10)    // Dia limite para fecho do período pelo RH (default: dia 10)
  closingAlertDays                   Int      @default(3)     // Dias de antecedência para aviso de fecho (default: 3)
  unclassifiedAbsenceBlocksClosing   Boolean  @default(false) // Se faltas não justificadas bloqueiam o fecho (default: false)
  timesheetSubmissionReminderHour    Int      @default(9)     // Hora do lembrete de submissão em Luanda (default: 09:00)

  updatedAt                     DateTime @updatedAt
}

// =============================================================
// 16. RECURSOS HUMANOS (RH) - FASE 2: PONTO E AUSÊNCIAS
// =============================================================

model HrWorkLocation {
  id               String                   @id @default(cuid())
  name             String
  latitude         Float
  longitude        Float
  radiusMeters     Float                    @default(100.0) // Raio de tolerância em metros
  verificationMode String                   @default("INFORMATIVO") // "INFORMATIVO" | "BLOQUEANTE"
  active           Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  employees        HrEmployeeWorkLocation[]
  timeEntries      HrTimeEntry[]
}

model HrEmployeeWorkLocation {
  id             String         @id @default(cuid())
  employeeId     String
  employee       HrEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workLocationId String
  workLocation   HrWorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([employeeId, workLocationId])
  @@index([employeeId])
  @@index([workLocationId])
}

model HrWorkDay {
  id                      String                    @id @default(cuid())
  employeeId              String
  employee                HrEmployee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                    String                    // "AAAA-MM-DD" referente ao dia de início em Luanda (UTC+1)
  actualIn                DateTime?
  actualOut               DateTime?
  totalMinutesWorked      Int                       @default(0)
  delayMinutes            Int                       @default(0)
  earlyDepartureMinutes   Int                       @default(0)
  overtimeMinutes         Int                       @default(0)
  overtimeStatus          String                    @default("SEM_HORA_EXTRA") // "SEM_HORA_EXTRA" | "PENDENTE" | "APROVADO" | "REJEITADO"
  overtimeApprovedMinutes Int                       @default(0)
  overtimeReviewedById    String?
  overtimeReviewedAt      DateTime?
  status                  String                    @default("NORMAL") // "NORMAL" | "ATRASO" | "SAIDA_EM_FALTA" | "FERIADO" | "AUSENTE_JUSTIFICADO" | "SEM_CALCULO"
  isComplete              Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  timeEntries             HrTimeEntry[]
  timeCorrections         HrTimeCorrectionRequest[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

model HrTimeEntry {
  id                 String                    @id @default(cuid())
  employeeId         String
  employee           HrEmployee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDayId          String?
  workDay            HrWorkDay?                @relation(fields: [workDayId], references: [id], onDelete: SetNull)
  type               String                    // "ENTRADA" | "INICIO_PAUSA" | "FIM_PAUSA" | "SAIDA"
  serverTime         DateTime                  @default(now()) // Sempre hora do servidor UTC
  origin             String                    @default("PORTAL") // "PORTAL" | "MANUAL_RH"
  authorId           String?                   // ID do utilizador autor da marcação
  authorName         String?                   // Nome do utilizador autor
  latitude           Float?
  longitude          Float?
  accuracyMeters     Float?
  isWithinRadius     Boolean                   @default(true)
  locationId         String?
  location           HrWorkLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  clientRequestId    String?                   @unique // Idempotência / Anti-duplo clique / Offline-sync
  notes              String?                   // Obrigatório se MANUAL_RH
  createdAt          DateTime                  @default(now())

  correctionRequests HrTimeCorrectionRequest[] @relation("CreatedEntry")

  @@index([employeeId])
  @@index([workDayId])
  @@index([serverTime])
}

model HrTimeCorrectionRequest {
  id              String       @id @default(cuid())
  employeeId      String
  employee        HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDayId       String?
  workDay         HrWorkDay?   @relation(fields: [workDayId], references: [id], onDelete: SetNull)
  date            String       // "AAAA-MM-DD"
  targetEntryType String       // "ENTRADA" | "INICIO_PAUSA" | "FIM_PAUSA" | "SAIDA"
  requestedTime   DateTime     // Data/hora solicitada
  reason          String       // Justificação obrigatória do funcionário
  status          String       @default("PENDENTE") // "PENDENTE" | "APROVADO" | "REJEITADO" | "CANCELADO"
  reviewedById    String?
  reviewedByName  String?
  reviewComment   String?
  reviewedAt      DateTime?
  createdEntryId  String?
  createdEntry    HrTimeEntry? @relation("CreatedEntry", fields: [createdEntryId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([employeeId])
  @@index([status])
}

model HrLeaveType {
  id                 String           @id @default(cuid())
  code               String           @unique // "FERIAS" | "DOENCA" | "MATERNIDADE" | "PATERNIDADE" | "CASAMENTO" | "LUTO" | "SEM_VENCIMENTO" | "OUTRA"
  name               String
  isPaid             Boolean          @default(true)
  deductsFromBalance Boolean          @default(false)
  requiresDocument   Boolean          @default(false)
  maxDays            Int?
  active             Boolean          @default(true)
  order              Int              @default(0)
  createdAt          DateTime         @default(now())

  leaveRequests      HrLeaveRequest[]
}

model HrLeaveBalance {
  id              String     @id @default(cuid())
  employeeId      String
  employee        HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year            Int        // Ex: 2026
  entitledDays    Int        @default(22)
  carriedOverDays Int        @default(0)
  usedDays        Int        @default(0)
  pendingDays     Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([employeeId, year])
  @@index([employeeId])
}

model HrLeaveRequest {
  id               String      @id @default(cuid())
  employeeId       String
  employee         HrEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        HrLeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate        DateTime
  endDate          DateTime
  workingDaysCount Int
  reason           String
  attachmentPath   String?
  attachmentName   String?
  status           String      @default("PENDENTE") // "PENDENTE" | "APROVADO" | "REJEITADO" | "CANCELADO"
  reviewedById     String?
  reviewedByName   String?
  reviewComment    String?
  reviewedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
}

model HrHoliday {
  id          String   @id @default(cuid())
  date        String   @unique // "AAAA-MM-DD"
  name        String
  isRecurring Boolean  @default(true)
  status      String   @default("A_CONFIRMAR") // "A_CONFIRMAR" | "CONFIRMADO"
  createdAt   DateTime @default(now())
}

model HrNotification {
  id              String   @id @default(cuid())
  recipientUserId String?
  employeeId      String?
  type            String   // "NOVO_PEDIDO_RH" | "DECISAO_PEDIDO" | "SAIDA_EM_FALTA" | "LEMBRETE_PONTO" | "LEMBRETE_FOLHA" | "AVISO_FECHO" | "INFO"
  title           String
  message         String
  link            String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, isRead])
  @@index([employeeId])
}

// =============================================================
// 17. RECURSOS HUMANOS (RH) - FASE 3A: FOLHAS DE PONTO E FECHO MENSAL
// =============================================================

model HrTimesheetPeriod {
  id              String                       @id @default(cuid())
  year            Int
  month           Int                          // 1 a 12
  code            String                       @unique // "AAAA-MM", ex: "2026-10"
  status          String                       @default("ABERTO") // "ABERTO" | "EM_REVISAO" | "FECHADO" | "REABERTO"
  version         Int                          @default(1)
  closedAt        DateTime?
  closedById      String?
  closedByName    String?
  closeNotes      String?
  reopenedAt      DateTime?
  reopenedById    String?
  reopenReason    String?
  payrollLockedAt DateTime?                    // Preparado para consumo e bloqueio da Fase 4 (Salários)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  timesheets      HrTimesheet[]
  snapshots       HrTimesheetVersionSnapshot[]
  payrollPeriod   HrPayrollPeriod?

  @@unique([year, month])
  @@index([status])
}

model HrTimesheet {
  id                       String                 @id @default(cuid())
  periodId                 String
  period                   HrTimesheetPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 HrEmployee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status                   String                 @default("ABERTA") // "ABERTA" | "SUBMETIDA" | "APROVADA" | "BLOQUEADA"
  submittedAt              DateTime?
  approvedAt               DateTime?
  approvedById             String?
  approvedByName           String?
  approvalNote             String?                // ex: "Aprovada sem submissão do funcionário"

  // Totais mensais consolidados
  expectedWorkDays         Int                    @default(0)
  workedDays               Int                    @default(0)
  totalMinutesWorked       Int                    @default(0)
  delayCount               Int                    @default(0)
  delayMinutes             Int                    @default(0)
  earlyDepartureMinutes    Int                    @default(0)
  unjustifiedAbsenceDays   Int                    @default(0)
  justifiedAbsenceDays     Int                    @default(0)
  paidLeaveDays            Int                    @default(0)
  unpaidLeaveDays          Int                    @default(0)
  holidayDays              Int                    @default(0)
  approvedOvertimeMinutes  Int                    @default(0)
  pendingOvertimeMinutes   Int                    @default(0)
  rejectedOvertimeMinutes  Int                    @default(0)
  missingExitDays          Int                    @default(0)
  outsideAreaDays          Int                    @default(0)

  // Metadados do cálculo e regras usadas
  rulesSnapshot            String?                // JSON com regras aplicadas (tolerância, arredondamento, horário contratual)
  calculatedAt             DateTime               @default(now())
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  days                     HrTimesheetDayDetail[]

  @@unique([periodId, employeeId])
  @@index([employeeId])
  @@index([status])
}

model HrTimesheetDayDetail {
  id                      String       @id @default(cuid())
  timesheetId             String
  timesheet               HrTimesheet  @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date                    String       // "AAAA-MM-DD"
  dayOfWeek               Int          // 0 = Domingo, 1 = Segunda, ...
  isExpectedWorkDay       Boolean      @default(true)
  scheduledDailyMinutes   Int          @default(480)
  
  // Registos reais
  actualIn                DateTime?
  actualOut               DateTime?
  minutesWorked           Int          @default(0)
  delayMinutes            Int          @default(0)
  earlyDepartureMinutes   Int          @default(0)
  
  // Horas extra do dia
  overtimeMinutes         Int          @default(0)
  overtimeStatus          String       @default("SEM_HORA_EXTRA") // "SEM_HORA_EXTRA" | "PENDENTE" | "APROVADO" | "REJEITADO"
  
  // Ausências e faltas
  status                  String       // "PRESENTE" | "ATRASO" | "FALTA_INJUSTIFICADA" | "FALTA_JUSTIFICADA" | "FERIAS" | "DOENCA" | "LICENCA" | "FERIADO" | "FOLGA" | "SAIDA_EM_FALTA" | "SEM_VINCULO"
  absenceReason           String?      // Motivo de justificação de falta pelo RH ou motivo de ausência
  absenceJustifiedById    String?
  absenceJustifiedByName  String?
  absenceJustifiedAt      DateTime?
  leaveRequestId          String?
  isOutsideArea           Boolean      @default(false)
  hasMissingExit          Boolean      @default(false)
  
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([timesheetId, date])
  @@index([date])
  @@index([status])
}

model HrTimesheetVersionSnapshot {
  id             String            @id @default(cuid())
  periodId       String
  period         HrTimesheetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  version        Int
  snapshotData   String            // JSON completo com totais, detalhe diário e regras de cada folha do período
  createdById    String?
  createdByName  String?
  notes          String?
  createdAt      DateTime          @default(now())

  @@unique([periodId, version])
  @@index([periodId])
}

// =============================================================
// 18. RECURSOS HUMANOS (RH) - FASE 4: PROCESSAMENTO SALARIAL
// =============================================================

model HrPayrollPeriod {
  id                 String            @id @default(cuid())
  timesheetPeriodId  String            @unique
  timesheetPeriod    HrTimesheetPeriod @relation(fields: [timesheetPeriodId], references: [id])
  code               String            @unique // "AAAA-MM", ex: "2026-10"
  year               Int
  month              Int               // 1 a 12
  status             String            @default("RASCUNHO") // "RASCUNHO" | "PROCESSADO" | "APROVADO" | "PAGO" | "FECHADO"
  
  totalGross         Decimal           @default(0)
  totalNet           Decimal           @default(0)
  totalInssWorker    Decimal           @default(0)
  totalInssCompany   Decimal           @default(0)
  totalIrt           Decimal           @default(0)
  totalEmployees     Int               @default(0)
  
  processedAt        DateTime?
  processedById      String?
  processedByName    String?
  approvedAt         DateTime?
  approvedById       String?
  approvedByName     String?
  paidAt             DateTime?
  paidById           String?
  paidByName         String?
  notes              String?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  payslips           HrPayslip[]

  @@unique([year, month])
  @@index([status])
}

model HrPayslip {
  id                   String           @id @default(cuid())
  payrollPeriodId      String
  payrollPeriod        HrPayrollPeriod  @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             HrEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timesheetId          String?
  contractId           String?
  status               String           @default("RASCUNHO") // "RASCUNHO" | "PROCESSADO" | "APROVADO" | "PAGO"
  payslipNumber        String           @unique // ex: "REC-2026-10-001"
  
  // Base e assiduidade
  baseSalary           Decimal          @default(0)
  dailyHours           Decimal          @default(8.0)
  hourlyRate           Decimal          @default(0)
  expectedWorkDays     Int              @default(22)
  workedDays           Int              @default(0)
  unjustifiedAbsences  Int              @default(0)
  absenceDeduction     Decimal          @default(0)
  overtimeMinutes      Int              @default(0)
  overtimePay          Decimal          @default(0)
  
  // Subsídios
  foodAllowance        Decimal          @default(0)
  transportAllowance   Decimal          @default(0)
  holidayAllowance     Decimal          @default(0)
  christmasAllowance   Decimal          @default(0)
  familyAllowance      Decimal          @default(0)
  otherAllowances      Decimal          @default(0)
  
  // Totais fiscais e tributários (Angola)
  grossSalary          Decimal          @default(0)
  taxableBaseInss      Decimal          @default(0)
  inssWorker           Decimal          @default(0)
  inssCompany          Decimal          @default(0)
  taxableBaseIrt       Decimal          @default(0)
  irtTax               Decimal          @default(0)
  otherDeductions      Decimal          @default(0)
  totalDeductions      Decimal          @default(0)
  netSalary            Decimal          @default(0)
  
  // Dados Bancários
  paymentMethod        String           @default("TRANSFERENCIA")
  bankName             String?
  bankIban             String?
  bankAccountNumber    String?
  
  generatedAt          DateTime         @default(now())
  paidAt               DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items                HrPayslipItem[]

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([status])
}

model HrPayslipItem {
  id                   String           @id @default(cuid())
  payslipId            String
  payslip              HrPayslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  code                 String           // "BASE", "FALTAS", "HORAS_EXTRA", "SUB_ALIMENTACAO", etc.
  description          String
  type                 String           // "VENCIMENTO" | "DESCONTO"
  amount               Decimal          @default(0)
  isTaxableIrt         Boolean          @default(true)
  isTaxableInss        Boolean          @default(true)
  order                Int              @default(0)

  @@index([payslipId])
}

// =============================================================
// 19. RECURSOS HUMANOS (RH) - FASE 6: AVALIAÇÃO DE DESEMPENHO & FORMAÇÃO
// =============================================================

model HrPerformanceCycle {
  id             String                @id @default(cuid())
  title          String                // ex: "Avaliação de Desempenho 2026"
  year           Int                   // 2026
  status         String                @default("PLANEADO") // "PLANEADO" | "ACTIVO" | "CONCLUIDO"
  startDate      DateTime
  endDate        DateTime
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  reviews        HrPerformanceReview[]

  @@unique([year, title])
  @@index([status])
}

model HrPerformanceReview {
  id                  String             @id @default(cuid())
  cycleId             String
  cycle               HrPerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId          String?
  reviewerName        String?
  status              String             @default("PENDENTE_AUTO") // "PENDENTE_AUTO" | "PENDENTE_AVALIADOR" | "CONCLUIDO"

  // Auto-avaliação do colaborador
  selfRating          Decimal?           @default(0)
  selfComments        String?
  selfSubmittedAt     DateTime?

  // Avaliação da chefia / RH
  managerRating       Decimal?           @default(0)
  managerComments     String?
  managerSubmittedAt  DateTime?

  // Pontuação final e ponderações
  objectivesRating    Decimal?           @default(0)
  competenciesRating  Decimal?           @default(0)
  finalScore          Decimal?           @default(0) // ex: 1.0 a 5.0
  performanceBand     String?            // "EXCELENTE" | "BOM" | "SATISFATORIO" | "NECESSITA_MELHORIA"

  // Plano de Desenvolvimento Individual (PDI)
  strengths           String?
  areasToImprove      String?
  developmentPlan     String?

  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([status])
}

model HrCertification {
  id             String     @id @default(cuid())
  employeeId     String
  employee       HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String     // ex: "Trabalho em Altura - NR35", "Fibra Óptica FTTH", "CCNA"
  issuingEntity  String     // ex: "Cisco", "Inspecção Geral do Trabalho", "MikroTik", "ISUTIC"
  licenseNumber  String?
  issueDate      DateTime
  expiryDate     DateTime?
  status         String     @default("VALIDA") // "VALIDA" | "A_EXPIRAR" | "EXPIRADA"
  attachmentUrl  String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([employeeId])
  @@index([status])
}

model HrTrainingCourse {
  id                String    @id @default(cuid())
  title             String    // ex: "Boas Práticas de Fusão de Fibra Óptica"
  provider          String    // Entidade formadora
  durationHours     Int       @default(8)
  category          String    @default("TECNICA") // "SEGURANCA" | "TECNICA" | "GESTAO" | "COMPLIANCE"
  startDate         DateTime
  endDate           DateTime?
  status            String    @default("PLANEADO") // "PLANEADO" | "EM_CURSO" | "CONCLUIDO"
  participantsCount Int       @default(0)
  location          String?   @default("Sede ARKNET Luanda")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category])
  @@index([status])
}

// =============================================================
// 20. RECURSOS HUMANOS (RH) - FASE 7: RECRUTAMENTO & ATS INTEGRADO
// =============================================================

model HrJobOpening {
  id             String         @id @default(cuid())
  title          String         // ex: "Técnico de Instalação e Redes de Telecomunicações"
  departmentId   String?
  department     HrDepartment?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       HrPosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  type           String         @default("FULL_TIME") // "FULL_TIME" | "TEMPORARIO" | "ESTAGIO"
  location       String         @default("Luanda")
  openingsCount  Int            @default(1)
  status         String         @default("ABERTA") // "ABERTA" | "PAUSADA" | "PREENCHIDA" | "CANCELADA"
  requirements   String?
  salaryRangeMin Decimal?
  salaryRangeMax Decimal?
  closingDate    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  candidates     HrCandidate[]

  @@index([departmentId])
  @@index([positionId])
  @@index([status])
}

model HrCandidate {
  id              String        @id @default(cuid())
  jobOpeningId    String?
  jobOpening      HrJobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  fullName        String
  email           String
  phone           String
  biNumber        String?
  experienceYears Int?          @default(0)
  resumeUrl       String?
  status          String        @default("NOVO") // "NOVO" | "TRIAGEM" | "ENTREVISTA" | "PROPOSTA" | "ADMITIDO" | "REJEITADO"
  admittedAsId    String?       // ID do HrEmployee quando admitido
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([jobOpeningId])
  @@index([status])
}



